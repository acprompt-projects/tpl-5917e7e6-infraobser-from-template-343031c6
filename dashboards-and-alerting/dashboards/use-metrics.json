{
  "dashboard": {
    "title": "USE Metrics - Utilization / Saturation / Errors",
    "tags": ["use", "baseline", "infrastructure"],
    "timezone": "utc",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(node_cpu_seconds_total, instance)",
          "refresh": 2,
          "includeAll": true,
          "current": { "text": "All", "value": "$__all" }
        }
      ]
    },
    "panels": [
      {
        "id": 1, "title": "CPU Utilization (%)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)", "legendFormat": "{{instance}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" }] } } }
      },
      {
        "id": 2, "title": "Memory Utilization (%)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})) * 100", "legendFormat": "{{instance}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 75, "color": "yellow" }, { "value": 90, "color": "red" }] } } }
      },
      {
        "id": 3, "title": "Disk I/O Saturation", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} {{device}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 0.8, "color": "yellow" }, { "value": 0.95, "color": "red" }] } } }
      },
      {
        "id": 4, "title": "Network Saturation (rx/tx drops)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(node_network_receive_drop_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} {{device}} rx-drop" },
          { "expr": "rate(node_network_transmit_drop_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} {{device}} tx-drop" }
        ]
      },
      {
        "id": 5, "title": "Disk Utilization (%)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "(1 - (node_filesystem_avail_bytes{instance=~\"$instance\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{instance=~\"$instance\",fstype!=\"tmpfs\"})) * 100", "legendFormat": "{{instance}} {{mountpoint}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 95, "color": "red" }] } } }
      },
      {
        "id": 6, "title": "System Errors (OOM / Context Switch)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(node_vmstat_oom_kill{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} oom-kill" },
          { "expr": "rate(node_context_switches_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} ctx-switch" }
        ]
      }
    ]
  },
  "overwrite": true
}